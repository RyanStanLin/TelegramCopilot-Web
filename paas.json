{
  "schemaVersion": 1,
  "name": "telegramcopilot-web",
  "state": "present",
  "deployBranch": "main",
  "services": {
    "web": {
      "type": "web",
      "build": {"context": ".", "dockerfile": "Dockerfile"},
      "port": 3000,
      "domain": "telegramcopilot.ryanl.in",
      "health": {"path": "/api/auth/status", "status": 200},
      "resources": {"memoryMiB": 192, "cpu": 0.5, "pids": 64},
      "environment": {
        "TELEGRAMCOPILOT_API_URL": "https://telegramcopilot-api.ryanl.in",
        "WEBAUTHN_ORIGIN": "https://telegramcopilot.ryanl.in",
        "WEBAUTHN_RP_ID": "telegramcopilot.ryanl.in",
        "WEB_DATA_PATH": "/data",
        "NODE_OPTIONS": "--max-old-space-size=112",
        "HOSTNAME": "0.0.0.0",
        "PORT": "3000"
      },
      "volumes": [{"name": "web-data", "target": "/data"}]
    }
  }
}
